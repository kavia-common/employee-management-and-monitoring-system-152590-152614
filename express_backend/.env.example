# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (MySQL)
# Note: Target MySQL running on port 5000 as per setup.
DB_HOST=localhost
DB_PORT=5000
DB_USER=root
DB_PASS=your_password_here
DB_NAME=employee_mgmt

# Auth
JWT_SECRET=please_change_me_super_secret_value
JWT_EXPIRES_IN=1d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
